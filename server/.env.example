# OpenPower API — environment configuration
# Copy to .env for local runs; never commit a filled-in .env.
# In production these are set via the systemd unit's Environment/EnvironmentFile,
# not via a .env file on disk.

# --- Database ---------------------------------------------------------------
# Direct Postgres connection string for the same database Supabase manages
# (Session Pooler / direct connection, NOT the pgbouncer transaction pooler,
# since this service holds an async SQLAlchemy engine with its own pool).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Find it in Supabase Dashboard -> Project Settings -> Database -> Connection string.
# This service connects with the postgres role that has service-role-equivalent
# privileges (bypasses RLS) — every handler MUST still do its own owner_id check.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@db.your-project-ref.supabase.co:5432/postgres

# --- Supabase project (for JWT/JWKS verification) ---------------------------
# Base URL of the Supabase project, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# JWKS endpoint used to verify user-session JWTs issued by Supabase Auth.
# Current (2026) Supabase projects sign JWTs asymmetrically (ES256 by default);
# the public keys are published here and rotate without redeploys.
# Defaults to "<SUPABASE_URL>/auth/v1/.well-known/jwks.json" if unset.
SUPABASE_JWKS_URL=

# Comma-separated list of JWT algorithms to accept. Must match the signing
# algorithm(s) your Supabase project's JWT signing keys use.
SUPABASE_JWT_ALGORITHMS=ES256,RS256

# Expected `aud` claim on Supabase-issued user JWTs. Default "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# Optional legacy fallback: only needed if your Supabase project has NOT been
# migrated to asymmetric JWT signing keys and still issues HS256 JWTs signed
# with the legacy shared "JWT Secret" (Project Settings -> API -> JWT Settings).
# Leave unset once migrated — asymmetric/JWKS verification is preferred and
# does not require this service to hold a shared secret at all.
SUPABASE_JWT_LEGACY_HS256_SECRET=

# --- Service ------------------------------------------------------------
# Bound to loopback only; Caddy reverse-proxies https://openpower.one/api/v1/...
# to http://127.0.0.1:<OPENPOWER_API_PORT>.
OPENPOWER_API_HOST=127.0.0.1
OPENPOWER_API_PORT=8100

# "development" enables permissive local defaults (e.g. allows sqlite:// DATABASE_URL
# for tests/local runs); "production" enforces a Postgres DATABASE_URL.
OPENPOWER_ENV=production

# --- Rate limiting (in-process, single-instance only; see ratelimit.py) -----
OPENPOWER_RATE_LIMIT_MAX=10
OPENPOWER_RATE_LIMIT_WINDOW_SECONDS=60

# --- AXP identity linking (openpower_axp.py) ---------------------------------
# Symmetric secret shared with every AXP instance a human links to their
# OpenPower account (see ~/LOCALCLOUD's auth_openpower.py / [auth.openpower]).
# Empty until set -- POST /agents/{id}/openpower-token 503s without it.
# Generate with e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
# and set the *same* value in AXP's config as OPENPOWER_SHARED_SECRET's env var.
OPENPOWER_AXP_SHARED_SECRET=
OPENPOWER_AXP_TOKEN_TTL_DAYS=365
